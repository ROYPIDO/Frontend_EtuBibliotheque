{
  "name": "etudiant-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:watch": "jest --watch",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "e2e": "start-server-and-test start http-get://localhost:4200 cypress:run",
    "e2e:open": "start-server-and-test start http-get://localhost:4200 cypress:open",
    "start:coverage": "ng run etudiant-frontend:serve-coverage",
    "cypress:run:coverage": "cypress run --expose coverage=true --config baseUrl=http://localhost:4300",
    "coverage:e2e:clean": "node tools/coverage.js clean",
    "coverage:e2e:report": "node tools/coverage.js report",
    "e2e:coverage": "npm run coverage:e2e:clean && start-server-and-test start:coverage http-get://localhost:4300 cypress:run:coverage && npm run coverage:e2e:report"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.0",
    "@angular/compiler": "^19.2.0",
    "@angular/core": "^19.2.0",
    "@angular/forms": "^19.2.0",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.0",
    "@angular/platform-browser-dynamic": "^19.2.0",
    "@angular/router": "^19.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "0.1902.16",
    "@angular-devkit/build-angular": "^19.0.7",
    "@angular/build": "19.2.16",
    "@angular/cli": "^19.2.16",
    "@angular/compiler-cli": "^19.2.0",
    "@cypress/code-coverage": "4.1.3",
    "@types/jest": "^29.5.4",
    "cypress": "15.14.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "^14.5.1",
    "nyc": "18.0.0",
    "start-server-and-test": "2.1.5",
    "typescript": "~5.7.2"
  }
}
